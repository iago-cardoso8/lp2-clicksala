PORT=3000
HOST=localhost
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
DATABASE_URL=file:./src/database/db.sqlite

# JWT Secret - MUDE ISSO EM PRODUÇÃO!
# Use uma chave segura com pelo menos 32 caracteres
# Exemplo: openssl rand -base64 32
JWT_SECRET=replace-with-at-least-32-random-characters

# SMTP (sem SMTP_HOST, o desenvolvimento usa uma conta Ethereal de teste)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ClickSala <no-reply@clicksala.local>
