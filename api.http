# REST Client (extensão REST Client do VS Code)
@server=http://localhost:3000
@email=joao@example.com
@password=senha123

### ============================================
### 1. CADASTRO DE USUÁRIO
### ============================================

# Esperado: 201 Created na primeira execução.
# Se o email já existir, a API responde 409 Conflict.
POST {{server}}/auth/register
Content-Type: application/json

{
  "nome": "João Silva",
  "email": "{{email}}",
  "password": "{{password}}"
}

### ============================================
### 2. AUTENTICAÇÃO VÁLIDA
### ============================================

# Esperado: 200 OK com user e token.
# A resposta nomeada permite reutilizar o JWT nas próximas requisições.
# @name login
POST {{server}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### ============================================
### 3. AUTENTICAÇÃO COM CREDENCIAIS INVÁLIDAS
### ============================================

# Esperado: 401 Unauthorized.
POST {{server}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "senha-incorreta"
}

### ============================================
### 4. ROTA PROTEGIDA SEM AUTENTICAÇÃO
### ============================================

# Esperado: 401 Unauthorized.
# Esta requisição não envia o header Authorization.
GET {{server}}/solicitacoes

### ============================================
### 5. MESMA ROTA PROTEGIDA APÓS AUTENTICAÇÃO
### ============================================

# Esperado: 200 OK.
# O token é lido diretamente da resposta da requisição nomeada login.
GET {{server}}/solicitacoes
Authorization: Bearer {{login.response.body.$.token}}

### ============================================
### COMPROVAÇÃO OPCIONAL DO TOKEN
### ============================================

# Esperado: 200 OK com os dados do usuário autenticado.
GET {{server}}/auth/me
Authorization: Bearer {{login.response.body.$.token}}

### ============================================
### SOLICITAÇÕES
### ============================================

### Listar salas disponíveis
GET {{server}}/solicitacoes/salas
Authorization: Bearer {{login.response.body.$.token}}

### Listar todas as solicitações
GET {{server}}/solicitacoes
Authorization: Bearer {{login.response.body.$.token}}

### Criar solicitação de sala
POST {{server}}/solicitacoes
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.token}}

{
  "sala": "SALA 1",
  "data": "2026-05-01",
  "hora": "14:00",
  "finalidade": "Reunião de projeto"
}

### Buscar uma solicitação por chave
GET {{server}}/solicitacoes/1/2026-05-01/14:00
Authorization: Bearer {{login.response.body.$.token}}

### Atualizar status de uma solicitação
PUT {{server}}/solicitacoes/1/2026-05-01/14:00
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.token}}

{
  "status": "Aprovado"
}

### Deletar uma solicitação
DELETE {{server}}/solicitacoes/1/2026-05-01/14:00
Authorization: Bearer {{login.response.body.$.token}}